# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Vars prefixed with VITE_ are exposed to the browser (must be public-safe).
# ─────────────────────────────────────────────────────────────

# Supabase client (browser) — only the public anon key, never the service key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Postgres connection (server-side only). For Vercel/serverless prefer the
# Supabase transaction pooler host (…pooler.supabase.com).
DATABASE_URL=

# Local dev server port
PORT=3000

# App URL (used for absolute links)
VITE_APP_URL=http://localhost:3000

# SMTP for booking + OTP emails (server-side only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Required server secrets — the server refuses to start without these
JWT_SECRET=
ADMIN_MASTER_PASSWORD=

# Comma-separated allowed CORS origins (defaults to localhost in dev)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Cloudinary media hosting (browser-exposed, public-safe).
# Use an UNSIGNED upload preset so no API secret ships to the client.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Optional Google Maps Embed API key. If blank, a keyless embed is used.
VITE_GOOGLE_MAPS_API_KEY=
